:SEARCH_GAME
cls
echo.
echo ============================================================
echo                      BUSCAR JUEGO
echo ============================================================
echo.
echo Escribe texto a buscar en el nombre de la carpeta
echo (O pulsa ENTER para volver al menu principal)
echo.
set S_TERM=
set /p S_TERM=Buscar: 
if "%S_TERM%"=="" goto MENU_MAIN
cls
echo.
echo Resultados para "%S_TERM%":
echo ------------------------------------------------------------
%G_DRV%
cd \GAMES
dir /b /ad *%S_TERM%*
echo ------------------------------------------------------------
echo.
echo Escribe el nombre de la carpeta para entrar:
echo (O pulsa ENTER para volver a buscar)
echo.
set S_DIR=
set /p S_DIR=Carpeta: 
if "%S_DIR%"=="" goto SEARCH_GAME
if not exist "%G_DRV%\GAMES\%S_DIR%\NUL" goto S_NOT_FOUND
cls
echo Entrando en: %S_DIR%
%G_DRV%
cd "\GAMES\%S_DIR%"
echo.
echo Ejecutables disponibles:
echo ------------------------------------------------------------
dir /b *.exe *.com *.bat
echo ------------------------------------------------------------
echo.
set S_EXE=
set /p S_EXE=Ejecutable a iniciar: 
if "%S_EXE%"=="" goto MENU_MAIN
echo.
echo Carpeta actual:
cd
echo Iniciando: %S_EXE%...
if not exist %S_EXE% goto S_EXE_MISSING
echo Ejecutando ahora...
%S_EXE%
%G_DRV%
cd \GAMES
echo.
echo ============================================================
echo  Programa finalizado.
echo  Pulsa cualquier tecla para volver al menu...
echo ============================================================
pause >nul
goto MENU_MAIN
:S_EXE_MISSING
echo.
echo ERROR: no encuentro ese ejecutable en la carpeta actual.
echo Ejecutables disponibles:
dir /b *.exe *.com *.bat
pause >nul
goto SEARCH_GAME

:S_NOT_FOUND
echo.
echo No se encontro la carpeta "%S_DIR%".
pause >nul
goto SEARCH_GAME

:RUN_GAME
cls
echo.
echo ============================================================
echo  INICIANDO JUEGO: %G_DIR%
echo  EJECUTABLE:     %G_EXE%
echo ============================================================
echo.
echo  Lanzando desde la particion de juegos...
echo ============================================================
%G_DRV%
cd "\GAMES\%G_DIR%"
echo.
echo Carpeta actual:
cd
echo.
echo Comprobando ejecutable: %G_EXE%
if not exist %G_EXE% goto GAME_FILE_MISSING
echo Ejecutando ahora...
echo.
echo ============================================================
%G_EXE%
goto GAME_RETURNED

:GAME_FILE_MISSING
echo.
echo ERROR: no encuentro el ejecutable en esta carpeta.
echo Contenido disponible:
dir /b *.exe *.com *.bat
goto GAME_DONE

:GAME_RETURNED
%G_DRV%
cd \GAMES
echo.
echo ============================================================
echo  Juego finalizado o ha vuelto al menu: %G_DIR%
echo ============================================================

:GAME_DONE
echo Pulsa cualquier tecla para volver al menu de juegos...
pause >nul
goto MENU_MAIN

