GOTO RUN

:G1162
SET GAME=Zorro
CD /D "%GAMES%\Zorro"
IF ERRORLEVEL 1 GOTO START
GOTO RUN

:G1163
SET GAME=Zyll.1984
CD /D "%GAMES%\Zyll.1984"
IF ERRORLEVEL 1 GOTO START
GOTO RUN

:SEARCH
CLS
ECHO.
ECHO ============================================================
ECHO                       BUSCAR JUEGO
ECHO ============================================================
ECHO.
SET SEARCH=
SET /P SEARCH=Texto a buscar: 
IF "%SEARCH%"=="" GOTO START
CLS
ECHO.
ECHO RESULTADOS:
ECHO.
DIR "%GAMES%\*%SEARCH%*" /AD /B
ECHO.
ECHO Escribe el nombre exacto de la carpeta.
ECHO ENTER = volver.
SET GAME=
SET /P GAME=Juego: 
IF "%GAME%"=="" GOTO START
CD /D "%GAMES%\%GAME%"
IF ERRORLEVEL 1 GOTO SEARCH
GOTO RUN

:RUN
CLS
ECHO.
ECHO ============================================================
ECHO %GAME%
ECHO ============================================================
ECHO.
ECHO EJECUTABLES:
ECHO.
DIR *.EXE /B
DIR *.COM /B
DIR *.BAT /B
ECHO.
ECHO Escribe el nombre del ejecutable.
ECHO ENTER = volver al listado.
SET EXE=
SET /P EXE=Ejecutar: 
IF "%EXE%"=="" GOTO START
%EXE%
ECHO.
ECHO El programa ha terminado.
PAUSE
GOTO RUN

:NOGAMES
CLS
ECHO.
ECHO ERROR: No se encontro GAMES.
PAUSE
GOTO EXIT

:EXIT
CLS
ECHO.
ECHO Saliendo de CAPYDOS...

