IF DEFINED GAMES GOTO START
IF EXIST G:\GAMES\NUL SET GAMES=G:\GAMES
IF DEFINED GAMES GOTO START
IF EXIST H:\GAMES\NUL SET GAMES=H:\GAMES
IF DEFINED GAMES GOTO START
IF EXIST I:\GAMES\NUL SET GAMES=I:\GAMES
IF DEFINED GAMES GOTO START
GOTO NOGAMES

